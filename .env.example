# Copy this file to .env and fill in real values.
# .env is never committed. .env.example is.

APP_NAME=NutriAI
APP_VERSION=0.1.0
ENVIRONMENT=development

# Server
HOST=127.0.0.1
PORT=8000

# Comma-separated. "*" is fine in development only.
CORS_ORIGINS=*

# AI provider: groq | ollama
AI_PROVIDER=groq

# Get a key at console.groq.com. Never commit this.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Local fallback, used when AI_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Database
DATABASE_URL=sqlite:///./nutriai.db

JWT_SECRET=generate-with-python-c-import-secrets-print-secrets-token_urlsafe-48
JWT_EXPIRE_DAYS=7
ADMIN_CREATION_SECRET=change-this-before-deploying
